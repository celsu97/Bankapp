@page "/CreateAccount"
@using Bankapp.Services
@inject IAccountService AccountService

<div class="container-fluid">
    <div class="row">
        <!-- LEFT COLUMN: Square to create account -->
        <div class="col-lg-4">
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-dark text-white">
                    <h4 class="mb-0"><i class="bi bi-plus-circle me-2"></i>New Account</h4>
                </div>
                <div class="card-body p-4">
                    <EditForm Model="_model" OnValidSubmit="CreateAccountAsync">
                        <DataAnnotationsValidator />
                        
                        @if (!string.IsNullOrEmpty(_createAccountValidationMessage))
                        {
                            <div class="alert alert-danger py-2">@_createAccountValidationMessage</div>
                        }

                        <div class="mb-3">
                            <label class="form-label fw-bold">Account Name</label>
                            <InputText @bind-Value="_model.Name" class="form-control" placeholder="e.g. Salary Account" />
                            <ValidationMessage For="@(() => _model.Name)" class="text-danger small" />
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">Type</label>
                                <InputSelect @bind-Value="_model.AccountType" class="form-select">
                                    <option value="@AccountType.Deposit">Deposit</option>
                                    <option value="@AccountType.Savings">Savings</option>
                                </InputSelect>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">Currency</label>
                                <InputSelect @bind-Value="_model.Currency" class="form-select">
                                    <option value="@Currency.SEK">SEK</option>
                                </InputSelect>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold">Initial Balance</label>
                            <div class="input-group">
                                <InputNumber @bind-Value="_model.InitialBalance" class="form-control" />
                                <span class="input-group-text">SEK</span>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-success w-100 fw-bold shadow-sm">
                            <i class="bi bi-check-lg"></i> Create Account
                        </button>
                    </EditForm>
                </div>
            </div>
        </div>

        <!-- HÖGER KOLUMN: Kontolista -->
        <div class="col-lg-8">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h3 class="fw-light">Current Holdings</h3>
                <span class="badge bg-secondary">Total: @_accounts.Count</span>
            </div>

            @if (_accounts.Count == 0)
            {
                <div class="text-center p-5 border rounded bg-light">
                    <p class="text-muted mb-0">No accounts registered yet.</p>
                </div>
            }
            else
            {
                <div class="row row-cols-1 row-cols-md-2 g-3">
                    @foreach (var account in _accounts)
                    {
                        <div class="col">
                            <div class="card h-100 shadow-sm border-start border-4 @(account.AccountType == AccountType.Savings ? "border-primary" : "border-info")">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between">
                                        <h5 class="card-title text-truncate">@account.Name</h5>
                                        <button class="btn btn-link text-danger p-0" @onclick="() => DeleteAccountAsync(account.Id)">
                                            <small>Delete</small>
                                        </button>
                                    </div>
                                    <h2 class="my-2 fw-bold">@account.Balance.ToString("N2") <small class="fs-6 fw-light">@account.Currency</small></h2>
                                    <div class="d-flex justify-content-between align-items-center mt-3">
                                        <span class="badge rounded-pill @(account.AccountType == AccountType.Savings ? "bg-primary" : "bg-info text-dark")">
                                            @account.AccountType
                                        </span>
                                        <small class="text-muted italic" style="font-size: 0.75rem;">
                                            Updated: @account.LastUpdated.ToLocalTime().ToString("HH:mm")
                                        </small>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

<!-- Code -->
@code 
{
    // Instance variables
    private CreateAccountModel _model = new();
    private List<BankAccount> _accounts = new();
    private string? _createAccountValidationMessage;

    [Inject] private IJSRuntime JS { get; set; } = default!;

    /// <summary>
    /// Called when the component is initialized.
    /// Ensures that account data is loaded and displayed in the UI.
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        await AccountService.EnsureLoadedAsync();
        _accounts = AccountService.GetAccounts();
        AccountService.StateChanged += OnStateChanged;

    }

    /// <summary>
    /// Called when the AccountService signals that state has changed.
    /// </summary>
    public void OnStateChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Handles the creation of a new account, validates input, sends data to account service, updates UI.
    /// </summary>
    private async Task CreateAccountAsync()
    {
        _createAccountValidationMessage = null;
        try
        {
            Console.WriteLine(_model.Name);
            await AccountService.CreateAccount(
                _model.Name,
                _model.AccountType,
                _model.Currency,
                _model.InitialBalance);

            // Update account list and reset the form
            _accounts = AccountService.GetAccounts();
            _model.Clear();
        }

        catch (Exception ex)
        {
            _createAccountValidationMessage = ex.Message;
            StateHasChanged();
            await Task.Delay(5000);
            _createAccountValidationMessage = null;
            StateHasChanged();
        }
    }

    /// <summary>
    /// Deletes the selected account after user confirmation.
    /// Updates the account list and refreshes the UI.
    /// </summary>
    /// <param name="Id">The unique identifier of the account to delete.</param>
    private async Task DeleteAccountAsync(Guid Id)
    {
        bool confirm = await JS.InvokeAsync<bool>("confirm", $"Do you want to delete this account??");
        if (!confirm)
        {
            return;
        }

        try
        {
            await AccountService.DeleteAccount(Id);
            _accounts = AccountService.GetAccounts(); 
            StateHasChanged(); 
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error when deleting account: {ex.Message}");
        }
    }

    /// <summary>
    /// The data required to create a new bank account
    /// </summary>
    private class CreateAccountModel
    {
        public string? Name { get; set; }
        public AccountType AccountType { get; set; }
        public Currency Currency { get; set; }
        public decimal InitialBalance { get; set; } = 0;
        
        //Resets the form after creating an account
        public void Clear()
        {
            Name = string.Empty;
            AccountType = AccountType.Deposit;
            Currency = Currency.SEK;
            InitialBalance = 0;
        }
    }
    
}