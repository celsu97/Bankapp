@using Bankapp.Domain
@using Bankapp.Interfaces
@inject IAccountService AccountService

<h3>Create New Bank Account</h3>

<div class="mb-2">
    <label>Name</label>
    <input class="form-control" @bind="name" />
</div>

<div class="mb-2">
    <label>Account Type</label>
    <select class="form-select" @bind="accountType">
        @foreach (var t in Enum.GetValues(typeof(AccountType)).Cast<AccountType>())
        {
            <option value="@t">@t</option>
        }
    </select>
</div>

<div class="mb-2">
    <label>Currency</label>
    <select class="form-select" @bind="currency">
        @foreach (var c in Enum.GetValues(typeof(CurrencyType)).Cast<CurrencyType>())
        {
            <option value="@c">@c</option>
        }
    </select>
</div>

<div class="mb-2">
    <label>Initial balance</label>
    <input type="number" class="form-control" @bind="initialBalance" />
</div>

