@page "/"
@inject IAccountService AccountService

<div class="container pb-5">
    <!-- Hero Sektion -->
    <div class="py-4 mb-4 border-bottom">
        <h1 class="display-5 fw-bold text-dark">Welcome!</h1>
        <p class="lead text-muted">Here is an overview of your financial status.</p>
    </div>

    @if (_accounts == null)
    {
        <div class="d-flex align-items-center">
            <div class="spinner-border text-primary me-3" role="status"></div>
            <span>Loading accounts...</span>
        </div>
    }
    else if (_accounts.Count == 0)
    {
        <div class="card border-0 shadow-sm bg-light text-center p-5">
            <div class="card-body">
                <i class="bi bi-wallet2 display-1 text-muted mb-3"></i>
                <h4>No accounts found</h4>
                <p class="text-muted">Get started by creating your first bank account.</p>
                <a href="/CreateAccount" class="btn btn-primary shadow-sm">Create Your First Account</a>
            </div>
        </div>
    }
    else
    {
        <!-- Översiktspanel -->
        <div class="row mb-4">
            <div class="col-12">
                <div class="d-flex justify-content-between align-items-end">
                    <h4 class="fw-bold mb-0">Your Accounts</h4>
                    <span class="text-muted small">Total Accounts: @_accounts.Count</span>
                </div>
            </div>
        </div>

        <!-- Dashboard Grid -->
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            @foreach (var account in _accounts)
            {
                <div class="col">
                    <div class="card h-100 border-0 shadow-sm hover-shadow">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <span class="badge rounded-pill @(account.AccountType == AccountType.Savings ? "bg-primary" : "bg-info text-dark")">
                                    @account.AccountType
                                </span>
                                <span class="text-muted small">@account.Currency</span>
                            </div>
                            
                            <h6 class="card-subtitle mb-1 text-muted small text-uppercase fw-bold">@account.Name</h6>
                            <h2 class="card-title fw-bold mb-0">
                                @account.Balance.ToString("N2")
                            </h2>
                        </div>
                        <div class="card-footer bg-transparent border-0 pb-3">
                            <hr class="my-2 opacity-10" />
                            <div class="d-flex justify-content-between align-items-center">
                                <a href="/History" class="btn btn-link btn-sm p-0 text-decoration-none">History →</a>
                                <small class="text-muted italic" style="font-size: 0.7rem;">Updated: @account.LastUpdated.ToShortDateString()</small>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<!-- Code -->
@code 
{
    //Instance variables
    private List<BankAccount>? _accounts;


    /// <summary>
    /// Gets all accounts when the page initializes.
    /// Ensures data is loaded from the service so the view can be populated.
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        // Ensures data is fetched before getting list of accounts
        await AccountService.EnsureLoadedAsync();
        
        // Get the current list of accounts
        _accounts = AccountService.GetAccounts();
        
        // Subscribe to state changes so the view updates if accounts change
        AccountService.StateChanged += OnStateChanged;
    }

    /// <summary>
    /// Method that runs when AccountService signals that data has changed.
    /// Updates the local list and forces the UI to re-render.
    /// </summary>
    private void OnStateChanged()
    {
        _accounts = AccountService.GetAccounts();
        InvokeAsync(StateHasChanged);
    }
}